<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only additions to the manifest.

  This file is merged only into the debug variant, so the release APK never
  contains ExtendedCaptureActivity. It is deliberately separate from the main
  manifest and from MainActivity: the extended capture test gets its own
  launcher entry and shares no code with the normal capture path.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      largeHeap: the extended capture renders a 4096x2048 sphere with several
      full-canvas float arrays, which needs more than the default debug heap.
      Debug only, so release is unaffected.
    -->
    <application android:largeHeap="true">

        <activity
            android:name=".extendedcapture.ExtendedCaptureActivity"
            android:exported="true"
            android:label="@string/extended_capture_label"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.PhotoSphere">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
