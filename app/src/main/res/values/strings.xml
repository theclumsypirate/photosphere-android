    <!-- Guided capture HUD. -->
    <string name="capture_scope_sphere">Sphere</string>
    <string name="capture_scope_ring">Horizon ring</string>
    <!-- Counted strings are plurals so translations can be correct in every
         language; see the issue on English-only strings. -->
    <plurals name="capture_progress_frames">
        <item quantity="one">frame</item>
        <item quantity="other">frames</item>
    </plurals>
    <!-- Spoken by a screen reader in place of the progress pill's separate numbers. -->
    <plurals name="capture_progress_description">
        <item quantity="one">%1$d of %2$d frame captured</item>
        <item quantity="other">%1$d of %2$d frames captured</item>
    </plurals>
    <plurals name="capture_rings">
        <item quantity="one">%1$d of %2$d band</item>
        <item quantity="other">%1$d of %2$d bands</item>
    </plurals>
