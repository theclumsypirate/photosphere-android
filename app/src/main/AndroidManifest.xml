<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Capture. Requested at runtime in MainActivity. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        Sensor sampling above 200 Hz (API 31+). Needed to track device attitude
        finely enough to guide the user between sphere frames. This is a normal
        permission: it is granted at install time and must NOT be requested at
        runtime.
    -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <!--
        The haptic tick that confirms an automatic capture. Normal permission,
        granted at install time.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Storage. On API 29+ the app writes through MediaStore and needs no
        storage permission at all, so WRITE is capped at API 28 (the only
        version that needs it). Nothing in the app ever reads the user's photo
        library — frames and spheres live in the app's own cache until the user
        exports them — so no READ permission is declared at all: not
        READ_EXTERNAL_STORAGE and not READ_MEDIA_IMAGES, which also keeps the
        Android 14+ selected-photos grant state from ever needing handling.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.sensor.gyroscope"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="false" />

    <application
        android:name=".PhotoSphereApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhotoSphere"
        tools:targetApi="31">

        <!--
            Portrait is a deliberate capture-screen decision (Google Camera does
            the same): the HUD is a top/bottom arrangement and the capture
            pipeline is tuned for it. From Android 16 the platform ignores fixed
            orientation on large screens and in multi-window, so a tablet can be
            force-rotated mid-session whether or not this is ready — the app
            handles that rather than fighting it: the capture target rotation
            follows the display, the optics re-read per configuration, and the
            HUD lays out sideways when the screen is wider than it is tall. See
            the orientation issue in the tracker. The lint flag is the
            deliberate, reviewed choice to keep the lock for phones.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.PhotoSphere"
            tools:ignore="LockedOrientationActivity,DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Lets the share sheet read a finished sphere out of the app's private
            cache. A file:// URI would throw FileUriExposedException on API 24+,
            so the result screen shares a content:// URI from here instead,
            granted per-recipient and revoked when the task ends.

            The authority follows the applicationId, so the debug build's
            ".debug" suffix keeps it from clashing with a release install.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
