*.iml
.gradle/
/local.properties
/.idea/
.DS_Store
/build
/app/build
/captures
.externalNativeBuild
.cxx
local.properties

# Local OpenCV SDK, if you use Option B from the README.
/third_party/

# Built APKs. A debug build is ~43 MB because OpenCV ships native libraries for
# every ABI, so committing one per rebuild grows the history by that much each
# time. Test builds are published as GitHub Release assets instead — see the
# "Test builds" section of the README. NEVER build APKs locally; use the
# `Android` CI workflow (manual dispatch or pull request) and its artifacts.
*.apk
*.aab

# Release signing keys must never be committed.
*.jks
*.keystore

# Local tool state: the Kotlin compiler cache and the opencode agent workspace.
/.kotlin/
/.opencode/

# Local bug screenshots shared with the agent, never committed.
/image_bugs/

# Test image sets (user-supplied, large, never committed).
/data_set/

# UI mockup proofs (generated PNGs, see kotlin_proof/render_ui.py).
/kotlin_proof/

# Pano prototype corpus + outputs (sourced on demand, see tools/pano_proto/).
/tools/pano_proto/ref/
/tools/pano_proto/out/
/tools/restitch_other/out/

# Python bytecode cache from the lab/prototype tools.
**/__pycache__/
# Agent workspace rules (local only, never committed).
/AGENTS.md

# Secrets, credentials and PII: never committed, no exceptions.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.asc
*.gpg
*credentials*.json
*secret*.json
*token*.txt
*token*.json
.tokens
.secrets/
secrets/
credentials/
google-services.json
GoogleService-Info.plist
